# The event app never silently switches provider. Local Qwen is the default candidate.
GRAPHOPS_EVENT_PROVIDER=ollama
GRAPHOPS_EVENT_MODEL=qwen3:8b
GRAPHOPS_OLLAMA_URL=http://127.0.0.1:11434
# Prefill batch size: smaller batches reduce temporary GPU-memory demand.
GRAPHOPS_OLLAMA_BATCH_SIZE=64

# Hosted option: provider=groq, model=qwen/qwen3.8-27b
# Enter credentials locally; keep this file as a template with no real keys.
GROQ_API_KEY=
OPENROUTER_API_KEY=

FALKORDB_HOST=localhost
FALKORDB_PORT=6379
GRAPHOPS_WORKSPACE=team-demo
GRAPHOPS_LAB_PORT=8865

# For a network deployment: unique random URL-safe value, at least 24 characters.
# Pass this environment variable to the TypeScript server as well as the worker.
GRAPHOPS_ACCESS_TOKEN=
GRAPHOPS_SECURE_COOKIE=0
