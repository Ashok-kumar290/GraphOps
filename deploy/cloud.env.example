# Copy to deploy/cloud.env on the server (setup-vm.sh does this for you).
# Never commit real credentials.

# Public hostname. Without a domain, use the VM's IP with dashes: 1-2-3-4.sslip.io
GRAPHOPS_DOMAIN=graphops.example.com

# Give this to judges privately. Generate with: openssl rand -hex 24
GRAPHOPS_ACCESS_TOKEN=

# 1 = anyone can browse the workspace, graph and results; running needs the token.
GRAPHOPS_PUBLIC_VIEW=1

GRAPHOPS_EVENT_PROVIDER=groq
GRAPHOPS_EVENT_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=
OPENROUTER_API_KEY=
